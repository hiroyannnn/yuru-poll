///|
/// scripts/embed_assets.py が web/ から生成する。手で編集しない。
/// `--web-dir` を指定しないとき、この中身を返す。
let embedded_assets : Map[String, String] = {
  "index.html": "<!doctype html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>ゆるアンケート 司会者画面</title>\n<style>\n  :root { --bg: #14161c; --fg: #f4f4f6; --muted: #9aa0ad; --bar: #4f8cff; --bar-bg: #262a35; --accent: #ffb454; }\n  * { box-sizing: border-box; }\n  body { margin: 0; background: var(--bg); color: var(--fg); font-family: system-ui, -apple-system, \"Hiragino Sans\", \"Noto Sans JP\", sans-serif; }\n  main { max-width: 1100px; margin: 0 auto; padding: 24px 16px; display: grid; grid-template-columns: 1fr 260px; gap: 24px; }\n  @media (max-width: 760px) { main { grid-template-columns: 1fr; } }\n  h1 { font-size: 2rem; margin: 0 0 16px; line-height: 1.3; }\n  .choice { margin: 12px 0; }\n  .choice .head { display: flex; justify-content: space-between; font-size: 1.25rem; margin-bottom: 4px; }\n  .choice .votes { font-variant-numeric: tabular-nums; color: var(--accent); }\n  .track { height: 28px; background: var(--bar-bg); border-radius: 6px; overflow: hidden; }\n  .fill { height: 100%; width: 0; background: var(--bar); transition: width .4s ease; }\n  .stats { color: var(--muted); margin-top: 16px; font-size: 1.05rem; }\n  .last { margin-top: 20px; padding: 12px; background: #1d2029; border-radius: 8px; color: var(--muted); }\n  .last b { color: var(--fg); }\n  .history { margin-top: 20px; display: none; }\n  .history h2 { font-size: 1rem; color: var(--muted); margin: 0 0 8px; font-weight: 600; }\n  .history ol { list-style: none; margin: 0; padding: 0; max-height: 320px; overflow-y: auto; border: 1px solid #2a2e3a; border-radius: 8px; }\n  .history li { padding: 8px 12px; border-bottom: 1px solid #2a2e3a; display: flex; justify-content: space-between; gap: 12px; }\n  .history li:last-child { border-bottom: 0; }\n  .history .said { overflow-wrap: anywhere; }\n  .history .read { color: var(--accent); white-space: nowrap; font-variant-numeric: tabular-nums; }\n  .admin { margin-top: 16px; display: none; gap: 8px; flex-wrap: wrap; }\n  .admin button { font-size: .9rem; padding: 8px 12px; border-radius: 8px; border: 1px solid #3a3f4d; background: transparent; color: var(--muted); cursor: pointer; }\n  .admin button.danger { color: #ff7b7b; border-color: #5a3038; }\n  aside { text-align: center; }\n  aside img { width: 100%; max-width: 240px; background: #fff; padding: 8px; border-radius: 8px; }\n  aside .url { word-break: break-all; font-size: .95rem; color: var(--muted); margin-top: 8px; }\n  aside .off { color: var(--accent); font-size: .9rem; }\n</style>\n</head>\n<body>\n<main>\n  <section>\n    <h1 id=\"question\">読み込み中…</h1>\n    <div id=\"choices\"></div>\n    <div class=\"stats\" id=\"stats\"></div>\n    <div class=\"last\" id=\"last\">まだ発言はありません</div>\n    <div class=\"history\" id=\"history\"><h2>発言の履歴（新しい順）</h2><ol id=\"history-list\"></ol></div>\n    <div class=\"admin\" id=\"admin\">\n      <button type=\"button\" id=\"reset\">集計をリセット</button>\n      <button type=\"button\" id=\"close\" class=\"danger\">ルームを閉じる</button>\n    </div>\n  </section>\n  <aside>\n    <img id=\"qr\" alt=\"参加用 QR コード\">\n    <div class=\"url\" id=\"join-url\"></div>\n    <div class=\"off\" id=\"join-off\"></div>\n  </aside>\n</main>\n<script>\n  // API の基点。native 版では '/api'、ホスト版では '/r/<ルーム>/api' になる。\n  const API = location.pathname.replace(/\\/(join|overlay)?\\/?$/, '') + '/api';\n  const state = { poll: null };\n  // ホスト版の司会者トークンは URL のフラグメント（#host=...）で渡される。native 版には無い\n  const hostToken = new URLSearchParams(location.hash.slice(1)).get('host') || '';\n  const authHeaders = hostToken ? { Authorization: 'Bearer ' + hostToken } : {};\n  const fmt = (v) => (Math.round(v * 10) / 10).toFixed(1);\n\n  async function loadPoll() {\n    const res = await fetch(API + '/poll');\n    state.poll = await res.json();\n    document.getElementById('question').textContent = state.poll.question;\n    const box = document.getElementById('choices');\n    box.innerHTML = '';\n    for (const c of state.poll.choices) {\n      if (c.key === 'none') continue;\n      const el = document.createElement('div');\n      el.className = 'choice';\n      el.innerHTML = `<div class=\"head\"><span>${esc(c.label)}</span><span class=\"votes\" data-votes=\"${c.key}\">0.0</span></div>\n        <div class=\"track\"><div class=\"fill\" data-fill=\"${c.key}\"></div></div>`;\n      box.appendChild(el);\n    }\n  }\n\n  async function loadJoinUrl() {\n    const res = await fetch(API + '/join-url');\n    const j = await res.json();\n    document.getElementById('join-url').textContent = j.url;\n    document.getElementById('join-off').textContent = j.accept_comments ? '' : '（この起動ではウェブからの参加は無効です）';\n  }\n\n  async function refresh() {\n    try {\n      const res = await fetch(API + '/tally');\n      const t = await res.json();\n      const s = t.snapshot;\n      let max = 0;\n      for (const c of state.poll.choices) if (c.key !== 'none') max = Math.max(max, s.totals[c.key] || 0);\n      for (const c of state.poll.choices) {\n        if (c.key === 'none') continue;\n        const v = s.totals[c.key] || 0;\n        document.querySelector(`[data-votes=\"${c.key}\"]`).textContent = fmt(v);\n        document.querySelector(`[data-fill=\"${c.key}\"]`).style.width = (max > 0 ? (v / max * 100) : 0) + '%';\n      }\n      document.getElementById('stats').textContent =\n        `参加 ${s.participants} 人 / 確定 ${s.confident} / 揺れ ${s.wavering} / どれでもない ${s.none_count}`;\n      if (t.last) {\n        const label = (k) => (state.poll.choices.find((c) => c.key === k) || { label: k }).label;\n        const dist = state.poll.choices.map((c) => `${esc(c.label)} ${Math.round((t.last.judgement.probabilities[c.key] || 0) * 100)}%`).join(' / ');\n        document.getElementById('last').innerHTML = `最新: <b>${esc(t.last.comment.text)}</b> → ${dist}`;\n      }\n    } catch (e) { /* サーバ停止中は次のポーリングを待つ */ }\n  }\n\n  // 発言の履歴。ホスト版では司会者トークンが無いと 401 になるので、そのときは欄ごと出さない\n  async function refreshHistory() {\n    try {\n      const res = await fetch(API + '/history', { headers: authHeaders });\n      if (!res.ok) return;\n      const { history } = await res.json();\n      const label = (k) => (state.poll.choices.find((c) => c.key === k) || { label: k }).label;\n      document.getElementById('history').style.display = 'block';\n      document.getElementById('history-list').innerHTML = history.map((h) => {\n        const p = Math.round((h.judgement.probabilities[h.judgement.choice] || 0) * 100);\n        return `<li><span class=\"said\">${esc(h.comment.text)}</span><span class=\"read\">${esc(label(h.judgement.choice))} ${p}%</span></li>`;\n      }).join('') || '<li><span class=\"said\">まだ発言はありません</span></li>';\n    } catch (e) { /* 次のポーリングを待つ */ }\n  }\n\n  async function adminAction(path, message) {\n    if (!confirm(message)) return false;\n    const res = await fetch(API + path, { method: 'POST', headers: authHeaders });\n    if (!res.ok) alert('できませんでした: ' + ((await res.json()).error || res.status));\n    return res.ok;\n  }\n\n  if (hostToken) {\n    document.getElementById('admin').style.display = 'flex';\n    document.getElementById('reset').addEventListener('click', async () => {\n      if (await adminAction('/reset', '集計と履歴を空にします。よろしいですか？')) { refresh(); refreshHistory(); }\n    });\n    document.getElementById('close').addEventListener('click', async () => {\n      if (await adminAction('/close', 'ルームを閉じて、集計と履歴を完全に消します。元に戻せません。よろしいですか？')) location.href = '/';\n    });\n  }\n\n  function esc(s) { return String(s).replace(/[&<>\"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[m])); }\n\n  loadPoll().then(() => {\n    refresh();\n    refreshHistory();\n    setInterval(() => { refresh(); refreshHistory(); }, 2000);\n  });\n  loadJoinUrl();\n  document.getElementById('qr').src = API + '/qr.svg';\n</script>\n</body>\n</html>\n",
  "join.html": "<!doctype html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>ゆるアンケート 参加</title>\n<style>\n  :root { --bg: #14161c; --fg: #f4f4f6; --muted: #9aa0ad; --bar: #4f8cff; --bar-bg: #262a35; --accent: #ffb454; }\n  * { box-sizing: border-box; }\n  body { margin: 0; background: var(--bg); color: var(--fg); font-family: system-ui, -apple-system, \"Hiragino Sans\", \"Noto Sans JP\", sans-serif; }\n  main { max-width: 560px; margin: 0 auto; padding: 20px 16px; }\n  h1 { font-size: 1.5rem; margin: 0 0 8px; line-height: 1.35; }\n  .hint { color: var(--muted); font-size: .95rem; margin-bottom: 16px; }\n  .hint code { color: var(--fg); }\n  form { display: flex; gap: 8px; }\n  input { flex: 1; font-size: 1.1rem; padding: 12px; border-radius: 8px; border: 1px solid #3a3f4d; background: #1d2029; color: var(--fg); min-width: 0; }\n  button { font-size: 1.1rem; padding: 12px 18px; border-radius: 8px; border: 0; background: var(--bar); color: #fff; }\n  button:disabled { opacity: .5; }\n  #result { margin-top: 20px; }\n  .interp { color: var(--muted); margin-bottom: 8px; }\n  .interp b { color: var(--fg); }\n  .choice { margin: 8px 0; }\n  .choice .head { display: flex; justify-content: space-between; margin-bottom: 3px; }\n  .track { height: 18px; background: var(--bar-bg); border-radius: 5px; overflow: hidden; }\n  .fill { height: 100%; width: 0; background: var(--bar); transition: width .4s ease; }\n  .top .fill { background: var(--accent); }\n  .error { color: #ff7b7b; margin-top: 12px; }\n</style>\n</head>\n<body>\n<main>\n  <h1 id=\"question\">読み込み中…</h1>\n  <div class=\"hint\" id=\"hint\">選択肢は選ばなくて OK。「たぶんA」「Bはないわ」「うーん迷う」みたいに自由にどうぞ。同じ人の最新の発言で上書きされます。</div>\n  <form id=\"form\">\n    <input id=\"comment\" type=\"text\" autocomplete=\"off\" placeholder=\"ひとこと\" maxlength=\"200\" required>\n    <button id=\"send\" type=\"submit\">送る</button>\n  </form>\n  <div class=\"error\" id=\"error\"></div>\n  <div id=\"result\"></div>\n</main>\n<script>\n  // API の基点。native 版では '/api'、ホスト版では '/r/<ルーム>/api' になる。\n  const API = location.pathname.replace(/\\/(join|overlay)?\\/?$/, '') + '/api';\n  const KEY = 'yuru-poll-participant-id';\n  let participantId = null;\n  try { participantId = localStorage.getItem(KEY); } catch (e) {}\n  if (!participantId) {\n    participantId = 'p' + Math.random().toString(36).slice(2, 10) + Date.now().toString(36);\n    try { localStorage.setItem(KEY, participantId); } catch (e) {}\n  }\n  let poll = null;\n\n  async function loadPoll() {\n    const res = await fetch(API + '/poll');\n    poll = await res.json();\n    document.getElementById('question').textContent = poll.question;\n    const labels = poll.choices.filter((c) => c.key !== 'none').map((c) => c.label).join(' / ');\n    document.getElementById('hint').innerHTML = `選択肢: <code>${esc(labels)}</code><br>選ばなくて OK。「たぶんA」「Bはないわ」「うーん迷う」みたいに自由にどうぞ。あなたの最新の発言で上書きされます。`;\n  }\n\n  document.getElementById('form').addEventListener('submit', async (ev) => {\n    ev.preventDefault();\n    const input = document.getElementById('comment');\n    const button = document.getElementById('send');\n    const text = input.value.trim();\n    if (!text) return;\n    button.disabled = true;\n    document.getElementById('error').textContent = '';\n    try {\n      const res = await fetch(API + '/comment', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ participant_id: participantId, comment: text }),\n      });\n      const j = await res.json();\n      if (!res.ok) throw new Error(j.error || res.statusText);\n      showResult(text, j.judgement);\n      input.value = '';\n    } catch (e) {\n      document.getElementById('error').textContent = '送れませんでした: ' + e.message;\n    } finally {\n      button.disabled = false;\n      input.focus();\n    }\n  });\n\n  function showResult(text, judgement) {\n    const box = document.getElementById('result');\n    const top = judgement.choice;\n    let html = `<div class=\"interp\">「<b>${esc(text)}</b>」はこう解釈されました:</div>`;\n    for (const c of poll.choices) {\n      const p = judgement.probabilities[c.key] || 0;\n      html += `<div class=\"choice ${c.key === top ? 'top' : ''}\"><div class=\"head\"><span>${esc(c.label)}</span><span>${Math.round(p * 100)}%</span></div>\n        <div class=\"track\"><div class=\"fill\" style=\"width:${p * 100}%\"></div></div></div>`;\n    }\n    box.innerHTML = html;\n  }\n\n  function esc(s) { return String(s).replace(/[&<>\"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[m])); }\n\n  loadPoll();\n</script>\n</body>\n</html>\n",
  "overlay.html": "<!doctype html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>ゆるアンケート オーバーレイ</title>\n<style>\n  :root { --fg: #ffffff; --bar: #4f8cff; --bar-bg: rgba(0,0,0,.45); --accent: #ffb454; }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; background: transparent; }\n  body { color: var(--fg); font-family: system-ui, -apple-system, \"Hiragino Sans\", \"Noto Sans JP\", sans-serif; font-weight: 700; text-shadow: 0 2px 6px rgba(0,0,0,.8); padding: 8px; }\n  h1 { font-size: 2.4rem; margin: 0 0 8px; line-height: 1.2; }\n  .choice { margin: 6px 0; }\n  .choice .head { display: flex; justify-content: space-between; font-size: 2rem; margin-bottom: 2px; }\n  .choice .votes { color: var(--accent); font-variant-numeric: tabular-nums; }\n  .track { height: 34px; background: var(--bar-bg); border-radius: 8px; overflow: hidden; }\n  .fill { height: 100%; width: 0; background: var(--bar); transition: width .4s ease; }\n  .stats { font-size: 1.4rem; margin-top: 6px; opacity: .9; }\n</style>\n</head>\n<body>\n  <h1 id=\"question\"></h1>\n  <div id=\"choices\"></div>\n  <div class=\"stats\" id=\"stats\"></div>\n<script>\n  // API の基点。native 版では '/api'、ホスト版では '/r/<ルーム>/api' になる。\n  const API = location.pathname.replace(/\\/(join|overlay)?\\/?$/, '') + '/api';\n  let poll = null;\n  const fmt = (v) => (Math.round(v * 10) / 10).toFixed(1);\n\n  async function loadPoll() {\n    poll = await (await fetch(API + '/poll')).json();\n    document.getElementById('question').textContent = poll.question;\n    const box = document.getElementById('choices');\n    box.innerHTML = '';\n    for (const c of poll.choices) {\n      if (c.key === 'none') continue;\n      const el = document.createElement('div');\n      el.className = 'choice';\n      el.innerHTML = `<div class=\"head\"><span>${esc(c.label)}</span><span class=\"votes\" data-votes=\"${c.key}\">0.0</span></div>\n        <div class=\"track\"><div class=\"fill\" data-fill=\"${c.key}\"></div></div>`;\n      box.appendChild(el);\n    }\n  }\n\n  async function refresh() {\n    try {\n      const s = (await (await fetch(API + '/tally')).json()).snapshot;\n      let max = 0;\n      for (const c of poll.choices) if (c.key !== 'none') max = Math.max(max, s.totals[c.key] || 0);\n      for (const c of poll.choices) {\n        if (c.key === 'none') continue;\n        const v = s.totals[c.key] || 0;\n        document.querySelector(`[data-votes=\"${c.key}\"]`).textContent = fmt(v);\n        document.querySelector(`[data-fill=\"${c.key}\"]`).style.width = (max > 0 ? (v / max * 100) : 0) + '%';\n      }\n      document.getElementById('stats').textContent = `参加 ${s.participants} 人`;\n    } catch (e) { /* 次のポーリングを待つ */ }\n  }\n\n  function esc(s) { return String(s).replace(/[&<>\"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[m])); }\n\n  loadPoll().then(() => { refresh(); setInterval(refresh, 2000); });\n</script>\n</body>\n</html>\n",
}
