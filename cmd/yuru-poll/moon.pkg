import {
  "hiroyannnn/yuru-poll/lib",
  "hiroyannnn/yuru-poll/runtime",
  "hiroyannnn/yuru-poll/jev",
  "hiroyannnn/yuru-poll/adapters/chat",
  "hiroyannnn/yuru-poll/adapters/terminal" @terminal_sink,
  "hiroyannnn/yuru-kit/sources",
  "hiroyannnn/yuru-poll/adapters/web" @web_adapter,
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/async",
  "moonbitlang/async/fs",
}

supported_targets = "-all+native"

pkgtype(kind: "executable")
