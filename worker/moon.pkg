import {
  "hiroyannnn/yuru-poll/lib",
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
  "moonbitlang/async/js_async",
  "bobzhang/qrc",
  "bobzhang/qrc/render" @qr_render,
}

import {
  "moonbitlang/async",
  "moonbitlang/core/json",
} for "test"

supported_targets = "-all+js"

options(
  link: {
    "js": {
      "exports": [ "room_new", "room_restore", "room_handle" ],
      "format": "esm",
    },
  },
)
