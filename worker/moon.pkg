import {
  "hiroyannnn/yuru-poll/lib",
  "hiroyannnn/yuru-kit" @kit,
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
  "moonbitlang/async/js_async",
}

import {
  "moonbitlang/async",
  "moonbitlang/core/json",
} for "test"

supported_targets = "-all+js"

options(
  link: {
    "js": {
      "exports": [
        "room_new",
        "room_restore",
        "room_handle",
        "limiter_new",
        "limiter_allow",
      ],
      "format": "esm",
    },
  },
)
